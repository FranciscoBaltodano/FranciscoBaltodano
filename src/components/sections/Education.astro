---
import { educationData } from "@/data/education"
---

<section
  id="education"
  class="mb-16 scroll-mt-16 md:mb-24 lg:mb-36 lg:scroll-mt-24"
  aria-label="Education"
>
  <div
    class="sticky top-0 z-20 -mx-6 mb-8 w-screen px-6 py-3 backdrop-blur-lg md:-mx-12 md:px-12 lg:relative lg:mx-auto lg:w-full lg:px-0"
  >
    <h2
      class="text-sm font-medium tracking-widest text-neutral-700 uppercase dark:text-neutral-300"
    >
      <span data-lang="es">Educación</span>
      <span data-lang="en">Education</span>
    </h2>
  </div>

  <div class="space-y-8">
    {
      educationData.map((item) => (
        <article class="group border-b border-neutral-200 pb-8 last:border-0 dark:border-neutral-800">
          <div class="flex gap-5">
            <!-- Logo -->
            <div
              class="flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-neutral-200 bg-neutral-50 p-2.5 transition-colors group-hover:border-neutral-300 dark:border-neutral-800 dark:group-hover:border-neutral-700"
            >
              <img
                src={item.logo}
                alt={`Logo de ${item.institution}`}
                class="max-h-full max-w-full object-contain"
                loading="lazy"
              />
            </div>

            <!-- Información -->
            <div class="min-w-0 flex-1">
              <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                <h3 class="font-medium text-neutral-900 dark:text-neutral-100">
                  {item.institution}
                </h3>

                <p class="shrink-0 text-xs text-neutral-500 dark:text-neutral-500">
                  <span data-lang="es">{item.period}</span>
                  <span data-lang="en">{item.period_en}</span>
                </p>
              </div>

              <p class="mt-1 text-sm text-emerald-800 dark:text-emerald-400">
                <span data-lang="es">{item.degree}</span>
                <span data-lang="en">{item.degree_en}</span>
              </p>

              <p class="mt-2 text-sm text-neutral-500 dark:text-neutral-400">
                {item.location}
              </p>

              {
                item.certificate ? (
                  <a
                    href={item.certificate}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-emerald-800 transition-colors hover:text-emerald-600 dark:text-emerald-400 dark:hover:text-emerald-300"
                  >
                    <span data-lang="es">Ver certificado</span>
                    <span data-lang="en">View certificate</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <span class="mt-4 inline-flex text-xs text-neutral-400 dark:text-neutral-600">
                    <span data-lang="es">Certificado próximamente</span>
                    <span data-lang="en">Certificate coming soon</span>
                  </span>
                )
              }
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
