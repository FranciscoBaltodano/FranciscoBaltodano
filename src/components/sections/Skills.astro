---
import { skills } from "@/data/skills"
import SectionTitle from "../common/SectionTitle.astro"
---

<section
  id="skills"
  class="mb-16 scroll-mt-16 md:mb-24 lg:mb-36 lg:scroll-mt-24"
  aria-label="Skills"
>
  <SectionTitle en="Skills" es="Habilidades" />

  <div class="space-y-10">
    {
      skills.map((category) => (
        <div>
          <div class="mb-6 flex items-center gap-4">
            <h3 class="shrink-0 text-sm font-medium text-neutral-700 dark:text-neutral-300">
              <span data-lang="es">{category.category}</span>
              <span data-lang="en">{category.category_en}</span>
            </h3>

            <div class="h-px flex-1 bg-neutral-200 dark:bg-neutral-800" />
          </div>

          <ul class="flex flex-wrap gap-x-8 gap-y-8">
            {category.skills.map((tech) => (
              <li class="group flex w-16 flex-col items-center">
                <div class="flex h-12 w-12 items-center justify-center transition-transform duration-300 group-hover:scale-150">
                  <tech.icon class="h-10 w-10" />
                </div>

                <span class="mt-3 text-center text-xs text-neutral-500 dark:text-neutral-400">
                  {tech.name}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
