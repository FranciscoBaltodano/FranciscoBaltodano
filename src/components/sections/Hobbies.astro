---
import { hobbiesData } from "@/data/hobbies"
---

<section
  id="hobbies"
  class="mb-16 scroll-mt-16 md:mb-24 lg:mb-36 lg:scroll-mt-24"
  aria-label="Hobbies"
>
  <div
    class="sticky top-0 z-20 -mx-6 mb-6 w-screen px-6 py-3 backdrop-blur-lg md:-mx-12 md:px-12 lg:relative lg:mx-auto lg:w-full lg:px-0"
  >
    <h2 class="text-sm font-bold tracking-widest text-neutral-200 uppercase">
      <span data-lang="es">Hobbies</span>
      <span data-lang="en">Hobbies</span>
    </h2>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    {
      hobbiesData.map((item) => (
        <article class="rounded-lg border border-neutral-800 bg-neutral-900/40 p-5 transition-colors hover:border-neutral-700">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg border border-neutral-800 bg-neutral-900 p-2">
            <img
              src={item.img}
              alt={`Logo de ${item.img}`}
              class="h-full w-full object-contain"
              loading="lazy"
            />
          </div>
          <h3 class="font-semibold text-neutral-200">
            <span data-lang="es">{item.name}</span>
            <span data-lang="en">{item.name_en}</span>
          </h3>

          <p class="mt-2 text-sm leading-relaxed text-neutral-400">
            <span data-lang="es">{item.description}</span>
            <span data-lang="en">{item.description_en}</span>
          </p>
        </article>
      ))
    }
  </div>
</section>
