---
import fs from "node:fs"
import path from "node:path"
import CertificatesGallery from "../common/CertificatesGallery.tsx"
import SectionTitle from "../common/SectionTitle.astro"

let certificateFiles = []
try {
  // Use process.cwd() assuming this is run in the project root during build
  const certificatesDir = path.join(process.cwd(), "public/certificates")
  certificateFiles = fs
    .readdirSync(certificatesDir)
    .filter((file) => file.match(/\.(jpeg|jpg|png|webp)$/i))
} catch (e) {
  console.error("Error reading certificates directory:", e)
}
---

<section
  id="certificates"
  class="mb-16 scroll-mt-16 md:mb-24 lg:mb-36 lg:scroll-mt-24"
  aria-label="Certificates"
>
  <SectionTitle en="Certificates" es="Certificados" />

  <CertificatesGallery client:load certificates={certificateFiles} />
</section>
