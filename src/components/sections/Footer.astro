---
import {
  IconBrandGithub,
  IconBrandLinkedin,
  IconMail,
} from "@tabler/icons-react"
---

<footer class="border-t border-neutral-200 dark:border-neutral-800">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-5 px-6 py-8 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="flex items-center gap-5">
      <a
        href="mailto:franciscobaltodano2003@gmail.com"
        aria-label="Email"
        class="text-neutral-500 transition-colors hover:text-emerald-800 dark:text-neutral-400 dark:hover:text-emerald-400"
      >
        <IconMail />
      </a>

      <a
        href="https://github.com/FranciscoBaltodano"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="text-neutral-500 transition-colors hover:text-emerald-800 dark:text-neutral-400 dark:hover:text-emerald-400"
      >
        <IconBrandGithub />
      </a>

      <a
        href="https://linkedin.com/in/FranciscoBaltodano"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="text-neutral-500 transition-colors hover:text-emerald-800 dark:text-neutral-400 dark:hover:text-emerald-400"
      >
        <IconBrandLinkedin />
      </a>
    </div>

    <p class="text-xs text-neutral-400">
      © {new Date().getFullYear()} Francisco Mejía
    </p>
  </div>
</footer>
