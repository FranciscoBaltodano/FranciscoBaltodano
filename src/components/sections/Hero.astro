---
import { Socials } from "../common/Socials"
---

<section class="px-6 py-10 md:py-16">
  <div class="mx-auto flex max-w-5xl items-center gap-12">
    <div class="max-w-2xl">
      <p
        class="mb-4 text-sm font-medium tracking-widest text-emerald-800 uppercase dark:text-emerald-400"
      >
        <span data-lang="es">Portafolio</span>
        <span data-lang="en">Portfolio</span>
      </p>

      <h1
        class="font-serif text-5xl leading-tight font-medium tracking-tight text-neutral-900 sm:text-6xl dark:text-white"
      >
        <span data-lang="es">Hola, soy</span>
        <span data-lang="en">Hi, I'm</span>

        <span class="text-emerald-800 dark:text-emerald-400"> Francisco. </span>
      </h1>

      <p
        class="mt-5 text-xl font-medium text-neutral-700 dark:text-neutral-300"
      >
        <span data-lang="es"> Ingeniero en Sistemas · Data & Software </span>
        <span data-lang="en"> Systems Engineer · Data & Software </span>
      </p>

      <p
        class="mt-4 max-w-xl text-base leading-7 text-neutral-600 dark:text-neutral-400"
      >
        <span data-lang="es">
          Ingeniero en Sistemas especializado en Data Engineering, ETL y SQL,
          con experiencia en desarrollo de software y QA Automation.
        </span>

        <span data-lang="en">
          Systems Engineer specialized in Data Engineering, ETL, and SQL, with
          experience in software development and QA Automation.
        </span>
      </p>

      <div class="mt-7 flex flex-col gap-4">
        <a
          href="mailto:franciscobaltodano2003@gmail.com"
          class="w-fit text-sm text-neutral-600 transition-colors hover:text-emerald-800 dark:text-neutral-400 dark:hover:text-emerald-400"
        >
          franciscobaltodano2003@gmail.com
        </a>

        <Socials client:load />
      </div>
    </div>

    <img
      src="/me.webp"
      alt="Francisco Mejía"
      class="hidden h-64 w-52 rounded-2xl object-cover md:block"
    />
  </div>
</section>
