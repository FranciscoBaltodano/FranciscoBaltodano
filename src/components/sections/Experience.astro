---
import { experiencenData } from "@/data/experience"
import SectionTitle from "@/components/common/SectionTitle.astro"
---

<section
  id="experience"
  class="mb-16 scroll-mt-16 md:mb-24 lg:mb-36 lg:scroll-mt-24"
  aria-label="Experience"
>
  <SectionTitle en="Experience" es="Experiencia" />

  <div class="relative">
    <!-- Línea de tiempo -->
    <div
      class="absolute bottom-0 left-5 top-0 hidden w-px bg-neutral-200 sm:block dark:bg-neutral-800"
    ></div>

    <div class="space-y-10">
      {
        experiencenData.map((item, index) => (
          <article class="relative grid grid-cols-[40px_1fr] gap-5">
            <!-- Punto de la timeline -->
            <div class="relative flex justify-center">
              <div
                class:list={[
                  "relative z-10 mt-1.5 h-2.5 w-2.5 rounded-full border-2 bg-white",
                  "border-emerald-800 dark:border-emerald-500 dark:bg-neutral-950",
                  index === 0 &&
                    "ring-4 ring-emerald-100 dark:ring-emerald-950",
                ]}
              />
            </div>

            <!-- Contenido -->
            <div class="pb-2">
              <div class="flex gap-4">
                <!-- Logo -->
                <div
                  class="flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-neutral-200 bg-neutral-50 p-2 dark:border-neutral-800 dark:bg-neutral-900"
                >
                  <img
                    src={item.logo}
                    alt={`Logo de ${item.institution}`}
                    class="max-h-full max-w-full object-contain"
                    loading="lazy"
                  />
                </div>

                <!-- Información -->
                <div class="min-w-0">
                  <h3
                    class="font-medium leading-tight text-neutral-900 dark:text-neutral-100"
                  >
                    {item.institution}
                  </h3>

                  <p class="mt-1 text-sm text-emerald-800 dark:text-emerald-400">
                    <span data-lang="es">{item.position}</span>
                    <span data-lang="en">{item.position_en}</span>
                  </p>

                  <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-500">
                    <span data-lang="es">{item.period}</span>
                    <span data-lang="en">{item.period_en}</span>
                  </p>
                </div>
              </div>

              <!-- Responsabilidades -->
              <div class="mt-4">
                <ul
                  data-lang="es"
                  class="space-y-2 text-sm leading-6 text-neutral-600 dark:text-neutral-400"
                >
                  {
                    item.tasks.map((task) => (
                      <li class="pl-4 before:mr-2 before:text-emerald-700 before:content-['•'] dark:before:text-emerald-500">
                        {task}
                      </li>
                    ))
                  }
                </ul>

                <ul
                  data-lang="en"
                  class="space-y-2 text-sm leading-6 text-neutral-600 dark:text-neutral-400"
                >
                  {
                    item.tasks_en.map((task) => (
                      <li class="pl-4 before:mr-2 before:text-emerald-700 before:content-['•'] dark:before:text-emerald-500">
                        {task}
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>