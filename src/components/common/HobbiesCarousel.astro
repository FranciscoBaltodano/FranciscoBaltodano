---
import { type HobbyItem } from "@/data/hobbies"

interface Props {
  hobbies: HobbyItem[]
}

const { hobbies } = Astro.props
---

<div
  class="mx-auto w-full max-w-md overflow-hidden rounded-2xl border border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-950"
  data-carousel
>
  <!-- Perfil -->
  <a
    href="https://www.instagram.com/ifranciscobaltodano/"
    class="flex items-center gap-3 p-4"
    rel="noopener noreferrer"
    target="_blank"
  >
    <img
      src="/me.webp"
      alt="Francisco Mejía"
      class="h-10 w-10 rounded-full object-cover"
    />
    <div>
      <p class="text-sm font-semibold">ifranciscobaltodano</p>
      <p class="text-xs text-neutral-500">
        <span data-lang="es">Un poco sobre mí</span>
        <span data-lang="en">A little about me</span>
      </p>
    </div>
  </a>

  <!-- Imágenes -->
  <div
    class="group relative aspect-[4/3] overflow-hidden bg-neutral-100 dark:bg-neutral-900"
    data-slider
  >
    {
      hobbies.map((hobby, index) => (
        <img
          src={hobby.img}
          alt={hobby.name}
          class="hobby-image absolute inset-0 h-full w-full object-cover"
          hidden={index !== 0}
          draggable="false"
        />
      ))
    }

    <!-- Indicadores de navegación para escritorio -->
    <div
      class="pointer-events-none absolute inset-0 hidden items-center justify-between px-3 md:flex"
    >
      <span
        class="flex h-8 w-8 items-center justify-center rounded-full bg-black/40 text-white opacity-0 transition-opacity group-hover:opacity-100"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
      </span>
      <span
        class="flex h-8 w-8 items-center justify-center rounded-full bg-black/40 text-white opacity-0 transition-opacity group-hover:opacity-100"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="m9 18 6-6-6-6"></path>
        </svg>
      </span>
    </div>
  </div>

  <!-- Acciones y puntos -->
  <div class="flex items-center justify-between px-4 pt-4">
    <div class="flex items-center gap-4">
      <!-- Me gusta -->
      <button
        type="button"
        data-like
        aria-label="Me gusta"
        aria-pressed="false"
        class="transition-colors"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-6 w-6"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <path
            d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"
          ></path>
        </svg>
      </button>

      <!-- Comentario -->
      <button
        type="button"
        data-comment
        aria-label="Comentario"
        class="transition-colors"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-6 w-6"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <path
            d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8A8.5 8.5 0 0 1 8.7 3.9a8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"
          ></path>
        </svg>
      </button>
    </div>

    <!-- Puntos -->
    <div class="flex items-center gap-1.5">
      {
        hobbies.map((_, index) => (
          <button
            type="button"
            data-dot={index}
            aria-label={`Ir al hobby ${index + 1}`}
            aria-current={index === 0 ? "true" : "false"}
            class:list={[
              "h-1.5 rounded-full transition-all",
              index === 0
                ? "w-5 bg-emerald-700 dark:bg-emerald-400"
                : "w-1.5 bg-neutral-300 dark:bg-neutral-700",
            ]}
          />
        ))
      }
    </div>

    <!-- Guardar -->
    <button
      type="button"
      data-save
      aria-label="Guardar"
      aria-pressed="false"
      class="transition-colors"
    >
      <svg
        viewBox="0 0 24 24"
        class="h-6 w-6"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
      >
        <path d="M6 4h12v17l-6-4-6 4V4Z"></path>
      </svg>
    </button>
  </div>

  <!-- Descripción -->
  <div class="px-4 pt-4 pb-5">
    {
      hobbies.map((hobby, index) => (
        <div class="hobby-content" hidden={index !== 0}>
          <h3 class="text-base font-semibold">
            <span data-lang="es">{hobby.name}</span>
            <span data-lang="en">{hobby.name_en}</span>
          </h3>
          <p class="mt-1 text-sm leading-6 text-neutral-600 dark:text-neutral-400">
            <span data-lang="es">{hobby.description}</span>
            <span data-lang="en">{hobby.description_en}</span>
          </p>
        </div>
      ))
    }
  </div>
</div>

<script>
  document.querySelectorAll("[data-carousel]").forEach((carousel) => {
    const images = carousel.querySelectorAll(".hobby-image")
    const contents = carousel.querySelectorAll(".hobby-content")
    const dots = carousel.querySelectorAll("[data-dot]")
    const slider = carousel.querySelector("[data-slider]")
    const like = carousel.querySelector("[data-like]")
    const save = carousel.querySelector("[data-save]")
    const comment = carousel.querySelector("[data-comment]")

    let active = 0
    let startX = 0

    function show(index) {
      if (!images.length) return

      active = (index + images.length) % images.length

      images.forEach((image, i) => {
        image.hidden = i !== active
      })

      contents.forEach((content, i) => {
        content.hidden = i !== active
      })

      dots.forEach((dot, i) => {
        const selected = i === active

        dot.setAttribute("aria-current", String(selected))
        dot.classList.toggle("w-5", selected)
        dot.classList.toggle("w-1.5", !selected)
        dot.classList.toggle("bg-emerald-700", selected)
        dot.classList.toggle("dark:bg-emerald-400", selected)
        dot.classList.toggle("bg-neutral-300", !selected)
        dot.classList.toggle("dark:bg-neutral-700", !selected)
      })
    }

    // Navegación por puntos
    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => show(index))
    })

    // Navegación por clic en la imagen
    slider.addEventListener("click", (event) => {
      const bounds = slider.getBoundingClientRect()
      const clickedRight = event.clientX > bounds.left + bounds.width / 2

      show(active + (clickedRight ? 1 : -1))
    })

    // Navegación táctil
    slider.addEventListener(
      "touchstart",
      (event) => {
        startX = event.touches[0].clientX
      },
      { passive: true }
    )

    slider.addEventListener(
      "touchend",
      (event) => {
        const difference = event.changedTouches[0].clientX - startX

        if (Math.abs(difference) > 40) {
          show(active + (difference < 0 ? 1 : -1))
        }
      },
      { passive: true }
    )

    // Me gusta
    like.addEventListener("click", () => {
      const liked = like.getAttribute("aria-pressed") !== "true"
      const icon = like.querySelector("svg")

      like.setAttribute("aria-pressed", String(liked))
      icon.classList.toggle("text-red-500", liked)
      icon.classList.toggle("fill-red-500", liked)
    })

    // Guardar
    save.addEventListener("click", () => {
      const saved = save.getAttribute("aria-pressed") !== "true"
      const icon = save.querySelector("svg")

      save.setAttribute("aria-pressed", String(saved))
      icon.classList.toggle("text-emerald-600", saved)
      icon.classList.toggle("fill-emerald-600", saved)
    })

    // Comentario
    comment.addEventListener("click", () => {
      comment.querySelector("svg").classList.toggle("text-emerald-600")
    })

    show(0)
  })
</script>

<style>
  [data-lang="en"] {
    display: none;
  }

  html[lang="en"] [data-lang="es"] {
    display: none;
  }

  html[lang="en"] [data-lang="en"] {
    display: inline;
  }

  [data-slider] {
    touch-action: pan-y;
    user-select: none;
    cursor: pointer;
  }

  [data-slider] img {
    pointer-events: none;
  }
</style>
