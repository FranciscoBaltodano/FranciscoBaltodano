---
const socials = [
  {
    name: "GitHub",
    url: "https://github.com/FranciscoBaltodano",
    image: "/socials/github.webp",
    description: "Mis proyectos y código fuente",
    description_en: "My projects and source code",
  },
  {
    name: "LinkedIn",
    url: "https://linkedin.com/in/FranciscoBaltodano",
    image: "/socials/linkedin.webp",
    description: "Mi perfil profesional",
    description_en: "My professional profile",
  },
]
---

<div class="flex flex-wrap items-center gap-4">
  {
    socials.map((social) => (
      <div class="group relative">
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-md px-2 py-1 text-sm font-medium text-neutral-600 transition-colors hover:text-neutral-950 dark:text-neutral-400 dark:hover:text-white"
        >
          {social.name}

          <span class="text-xs opacity-0 transition-opacity group-hover:opacity-100">
            ↗
          </span>
        </a>

        <div class="pointer-events-none absolute bottom-full left-1 z-50 w-72 pb-2 opacity-0 transition-opacity duration-200 group-hover:pointer-events-auto group-hover:opacity-100">
          <div class="translate-y-2 transition-transform duration-200 group-hover:translate-y-0">
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group/card block overflow-hidden rounded-xl border border-neutral-200 bg-white shadow-xl dark:border-neutral-800 dark:bg-neutral-950"
            >
              <div class="relative overflow-hidden">
                <img
                  src={social.image}
                  alt={`Vista previa de ${social.name}`}
                  class="block w-full object-contain transition-transform duration-300 group-hover/card:scale-105"
                  loading="lazy"
                />

                <div class="absolute inset-0 flex items-center justify-center bg-black/0 transition-colors group-hover/card:bg-black/20">
                  <span class="rounded-full bg-white/90 px-3 py-1.5 text-xs font-medium text-neutral-900 opacity-0 shadow-sm transition-opacity group-hover/card:opacity-100">
                    <span data-lang="es">Visitar Perfil ↗</span>
                    <span data-lang="en">Visit profile ↗</span>
                  </span>
                </div>
              </div>

              <div class="p-3">
                <p class="text-sm font-semibold text-neutral-900 dark:text-white">
                  {social.name}
                </p>

                <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">
                  <span data-lang="es">{social.description}</span>
                  <span data-lang="en">{social.description_en}</span>
                </p>
              </div>
            </a>
          </div>
        </div>
      </div>
    ))
  }
</div>

<style>
  [data-lang="en"] {
    display: none;
  }

  html[lang="en"] [data-lang="es"] {
    display: none;
  }

  html[lang="en"] [data-lang="en"] {
    display: inline;
  }
</style>
