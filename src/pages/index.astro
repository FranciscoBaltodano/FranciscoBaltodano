---
import Layout from "@/layouts/main.astro"
import Navbar from "@/components/common/Navbar.astro"
import AboutMe from "@/components/sections/AboutMe.astro"
import Education from "@/components/sections/Education.astro"
import Experience from "@/components/sections/Experience.astro"
import Skills from "@/components/sections/Skills.astro"
import Certificates from "@/components/sections/Certificates.astro"
import Hobbies from "@/components/sections/Hobbies.astro"
import Hero from "@/components/sections/Hero.astro"
import Footer from "@/components/sections/Footer.astro"
---

<Layout>
  <div>
    <Navbar />
    <div class="flex w-full flex-col items-center px-4 py-6 sm:px-6">
      <div
        class="mt-8 flex w-full max-w-3xl min-w-0 flex-col gap-12 text-sm leading-loose"
      >
        <Hero />
        <AboutMe />
        <Experience />
        <Education />
        <Skills />
        <Certificates />
        <Hobbies />
        <Footer />
      </div>
    </div>
  </div>
</Layout>
